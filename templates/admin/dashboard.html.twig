{% extends '@EasyAdmin/layout.html.twig' %}

{% block main %}
    <section class="cars-floor">
        <div class="cars-hero">
            <div>
                <p class="cars-kicker">{{ 'dashboard.kicker'|trans({}, 'messages') }}</p>
                <h1>{{ 'dashboard.title'|trans({}, 'messages') }}</h1>
                <p class="cars-lede">{{ 'dashboard.lede'|trans({}, 'messages') }}</p>
            </div>
            <div class="hero-modules">
                <div><b>{{ 'dashboard.module_diagnostics'|trans({}, 'messages') }}</b><span>{{ 'dashboard.module_catalog'|trans({}, 'messages') }}</span></div>
                <div><b>{{ 'dashboard.module_intervals'|trans({}, 'messages') }}</b><span>{{ procedures }}</span></div>
                <div><b>{{ 'dashboard.module_reminders'|trans({}, 'messages') }}</b><span>{{ reminders }}</span></div>
            </div>
        </div>

        <div class="cars-stats">
            <article>
                <span>{{ 'dashboard.stat_garage'|trans({}, 'messages') }}</span>
                <strong>{{ vehicles }}</strong>
                <em>{{ 'dashboard.stat_garage_hint'|trans({}, 'messages') }}</em>
            </article>
            <article>
                <span>{{ 'dashboard.stat_owners'|trans({}, 'messages') }}</span>
                <strong>{{ users }}</strong>
                <em>{{ 'dashboard.stat_owners_hint'|trans({}, 'messages') }}</em>
            </article>
            <article>
                <span>{{ 'dashboard.stat_marques'|trans({}, 'messages') }}</span>
                <strong>{{ brands }}</strong>
                <em>{{ 'dashboard.stat_marques_hint'|trans({}, 'messages') }}</em>
            </article>
            <article>
                <span>{{ 'dashboard.stat_desk'|trans({}, 'messages') }}</span>
                <strong>{{ openRequests }}</strong>
                <em>{{ 'dashboard.stat_desk_hint'|trans({}, 'messages') }}</em>
            </article>
        </div>

        <div class="cars-board">
            <header>
                <h2>{{ 'dashboard.recent_vehicles'|trans({}, 'messages') }}</h2>
                <p>{{ 'dashboard.recent_meta'|trans({'%count%': reminders, '%procedures%': procedures}, 'messages') }}</p>
            </header>
            <table>
                <thead>
                    <tr>
                        <th>{{ 'dashboard.table_vehicle'|trans({}, 'messages') }}</th>
                        <th>{{ 'dashboard.table_owner'|trans({}, 'messages') }}</th>
                        <th>{{ 'dashboard.table_year'|trans({}, 'messages') }}</th>
                        <th>{{ 'dashboard.table_configuration'|trans({}, 'messages') }}</th>
                        <th>{{ 'dashboard.table_mileage'|trans({}, 'messages') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for vehicle in recentVehicles %}
                        <tr>
                            <td>
                                <b>{{ vehicle.generation }}</b>
                                <small>{{ vehicle.vin ?? vehicle.licensePlate ?? ('dashboard.no_plate'|trans({}, 'messages')) }}</small>
                            </td>
                            <td>{{ vehicle.user }}</td>
                            <td>{{ vehicle.year }}</td>
                            <td>{{ vehicle.configuration }}</td>
                            <td>{{ vehicle.mileageKm }} km</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5">{{ 'dashboard.no_vehicles'|trans({}, 'messages') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
