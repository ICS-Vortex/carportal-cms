<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in · Car Portal</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@420;520;640&display=swap">
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
</head>
<body>
    <main class="gate">
        <section class="stage" aria-hidden="true">
            <div class="stage-top">
                <span class="mark">CP</span>
                <span class="live"><i></i> Service online</span>
            </div>
            <div class="stage-copy">
                <p class="kicker">Car Portal</p>
                <h1>Service console</h1>
                <p>Maintenance intervals, diagnostics, and workshop schedules for every vehicle in the garage.</p>
            </div>
            <div class="bays">
                <article>
                    <span>01</span>
                    <strong>Diagnostics</strong>
                    <em>Live vehicle health</em>
                </article>
                <article>
                    <span>02</span>
                    <strong>Intervals</strong>
                    <em>Mileage and time</em>
                </article>
                <article>
                    <span>03</span>
                    <strong>Workshop</strong>
                    <em>Plans and reminders</em>
                </article>
                <article class="bay-wide">
                    <span>SYS</span>
                    <strong>Catalog, service logs, and owner records in one desk.</strong>
                </article>
            </div>
        </section>
        <section class="panel">
            <form method="post" action="{{ path('app_login') }}">
                <p class="kicker">Staff access</p>
                <h2>Sign in</h2>
                <p class="form-note">Workshop editors and administrators.</p>
                {% if error %}
                    <p class="gate-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                {% endif %}
                <label>
                    Email
                    <input type="email" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                </label>
                <label>
                    Password
                    <input type="password" name="_password" autocomplete="current-password" required>
                </label>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit">Continue</button>
            </form>
        </section>
    </main>
</body>
</html>
