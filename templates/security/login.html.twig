<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in · CARS Atelier</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,520;9..144,640&family=Outfit:wght@360;480;560&display=swap">
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
</head>
<body>
    <main class="gate">
        <section class="gate-stage">
            <p class="kicker">Car Portal CMS</p>
            <h1>CARS</h1>
            <p class="stage-copy">The floor, the book, and the desk. Editors only.</p>
            <svg viewBox="0 0 680 150" aria-hidden="true">
                <path d="M30 104 H138 C160 104 172 78 198 74 H292 L332 42 H448 L492 74 H548 C578 74 596 92 608 104 H650" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="196" cy="106" r="22" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="548" cy="106" r="22" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <path d="M18 124 H662" fill="none" stroke="currentColor" stroke-width="1" opacity="0.45"/>
            </svg>
        </section>
        <section class="gate-form">
            <form method="post" action="{{ path('app_login') }}">
                <p class="kicker">Atelier</p>
                <h2>Sign in</h2>
                {% if error %}
                    <p class="gate-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                {% endif %}
                <label>
                    Email
                    <input type="email" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                </label>
                <label>
                    Password
                    <input type="password" name="_password" autocomplete="current-password" required>
                </label>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit">Enter the floor</button>
            </form>
        </section>
    </main>
</body>
</html>
