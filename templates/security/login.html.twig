<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Вхід · Carmain</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Rubik:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
</head>
<body>
    <header class="shop-header">
        <div class="shop-header-inner">
            <span class="display">Carmain</span>
            <span class="tagline">Сервіс авто</span>
        </div>
    </header>
    <main class="login-main">
        <p class="shop-kicker">Адмін</p>
        <h1>Вхід</h1>
        <p class="login-lede">Доступ для редакторів каталогу та адміністраторів сервісу.</p>
        <div class="login-panel">
            <form method="post" action="{{ path('app_login') }}">
                {% if error %}
                    <p class="gate-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                {% endif %}
                <label>
                    Email
                    <input type="email" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                </label>
                <label>
                    Пароль
                    <input type="password" name="_password" autocomplete="current-password" required>
                </label>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit">Увійти</button>
            </form>
        </div>
    </main>
</body>
</html>
